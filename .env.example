# Copy to .env for local/docker-compose development.
# Never commit real secrets.

# LLM provider keys. Provide the key for whichever provider you use.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
SELDON_API_KEY=

# Optional: Supadata transcript API for `seldon research transcripts fetch` (videos without
# captions, TikTok/Instagram/X/Facebook, media files). YouTube captions need no key.
# The API loads this file; the standalone research CLI reads only its process environment.
# SUPADATA_API_KEY=

# LLM provider selection. Leave blank to auto-detect: NVIDIA NIM if NVIDIA_API_KEY
# is set, else OpenRouter if OPENROUTER_API_KEY is set. Set explicitly to force one.
# SELDON_LLM_PROVIDER=nvidia   # or: openrouter

# Optional: override individual model roles (these env vars are honored by
# config_from_env). See src/seldon/config.py provider_preset() for the defaults.
# SELDON_DEFAULT_MODEL=
# SELDON_FAST_MODEL=
# SELDON_REASONING_MODEL=

# Optional: fully override the endpoint/key env var (advanced; any OpenAI-compatible API).
# SELDON_LLM_BASE_URL=
# SELDON_LLM_API_KEY_ENV=
